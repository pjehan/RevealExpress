{
  "name": "revealexpress",
  "version": "2.0.0",
  "description": "Start RevealJS slideshow with ExpressJS server",
  "keywords": [
    "revealjs",
    "expressjs",
    "teach",
    "learn",
    "code",
    "presentation",
    "share"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pjehan/RevealExpress.git"
  },
  "private": false,
  "type": "module",
  "preferGlobal": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/shared src/server/dev.ts",
    "start": "node dist/server/cli.js",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -b && vite build",
    "typecheck": "tsc -b",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "revealexpress": "dist/server/cli.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "express": "^5.2.1",
    "open": "^11.0.4",
    "socket.io": "^4.8.3",
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.1.1",
    "font-awesome": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reveal.js": "^6.0.2",
    "sass": "^1.104.1",
    "socket.io-client": "^4.8.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.0"
  }
}
